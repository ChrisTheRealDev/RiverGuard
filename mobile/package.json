{
  "name": "riverguard-android",
  "version": "2.0.0-preview.1",
  "private": true,
  "scripts": {
    "build:offline": "cd ../frontend && node node_modules/vite/bin/vite.js build --config vite.phone.config.ts",
    "check:offline": "cd ../frontend && node node_modules/typescript/bin/tsc --project tsconfig.phone.json",
    "apk:debug": "npm run build:offline && cap sync android && cd android && gradlew.bat assembleDebug",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
